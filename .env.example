# ==================================================
# MySQL
# ==================================================
MYSQL_ROOT_PASSWORD=root123
MYSQL_USER=aidevelop
MYSQL_PASSWORD=aidevelop123

# Spring Boot 数据源（对应 application.yml 中的 ${DB_*}）
DB_URL=jdbc:mysql://localhost:3306/ai_develop?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8
DB_USERNAME=aidevelop
DB_PASSWORD=aidevelop123

# ==================================================
# Milvus
# ==================================================
MILVUS_ENABLED=true
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DATABASE=default
MILVUS_COLLECTION=knowledge_vectors
MILVUS_EMBEDDING_DIMENSION=2048
RAG_EMBEDDING_BATCH_SIZE=10

# ==================================================
# 火山方舟 Agent Plan / OpenAI 兼容 API (对应 application-openai.yml)
# ==================================================
OPENAI_API_KEY=ark-your-key-here
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
OPENAI_CHAT_COMPLETIONS_PATH=/chat/completions
OPENAI_EMBEDDINGS_PATH=/embeddings
OPENAI_CHAT_MODEL=your-chat-endpoint-id
EMBEDDING_MODEL=doubao-embedding-vision
AI_HTTP_CONNECT_TIMEOUT_MS=10000
AI_HTTP_READ_TIMEOUT_MS=60000
